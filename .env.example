# Local dev only. Copy to .env.local. Never commit .env.local.
# The live site is static; its backend is the Supabase Edge Function `sports`,
# whose secrets live in Supabase → Edge Functions → Secrets (see README).
# With Supabase and Resend blank, `npm run dev` stores leads in .local-data/
# and prints emails to the terminal instead.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM="Janobi Sports <sports@outreach.janobi.agency>"
LEAD_NOTIFY_EMAIL=wajeeh@janobi.agency
# 24+ random characters. Signs the private "log the call" links in lead alerts.
OUTCOME_SECRET=

# Cal.com: the part after cal.com/, e.g. wajeehfromjanobi/brand-audit
NEXT_PUBLIC_CAL_LINK=wajeehfromjanobi/brand-audit
NEXT_PUBLIC_CAL_ORIGIN=https://app.cal.com
CAL_WEBHOOK_SECRET=

# Optional: point a dev build at another backend.
# NEXT_PUBLIC_API_BASE=
