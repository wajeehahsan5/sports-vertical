# Copy to .env.local and fill in. Never commit .env.local.
# With Supabase and Resend blank, `npm run dev` stores leads in .local-data/
# and prints emails to the terminal instead.

# Supabase (server only)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend. Hostinger stores values literally: paste WITHOUT quotes there.
RESEND_API_KEY=
RESEND_FROM="Janobi Sports <sports@outreach.janobi.agency>"
LEAD_NOTIFY_EMAIL=wajeeh@janobi.agency
# 24+ random characters. Signs the private "log the call" links in lead alerts.
OUTCOME_SECRET=

# Cal.com: the part after cal.com/, e.g. wajeehfromjanobi/brand-audit
NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_CAL_ORIGIN=
# Cal.com → Settings → Developer → Webhooks: https://sports.janobi.agency/api/cal,
# triggers BOOKING_CREATED + BOOKING_RESCHEDULED, same 24+ character secret here.
CAL_WEBHOOK_SECRET=

# Escape hatch for testing `next start` locally without Supabase.
# ALLOW_LOCAL_STORE=1
